<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>就職指導・企業管理システム プロトタイプ</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif; }
        .modal-backdrop { background-color: rgba(0, 0, 0, 0.4); }
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">

    <header class="bg-indigo-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 flex justify-between items-center h-16">
            <div class="flex items-center space-x-6">
                <h1 class="text-xl font-bold tracking-wider flex items-center">
                    <span class="bg-white text-indigo-950 font-black px-2 py-0.5 rounded mr-2 text-sm">システム</span>
                    就職指導・企業管理
                </h1>
                <nav class="flex space-x-1 h-16 pt-2">
                    <button id="tab-btn-company" onclick="switchTab('company')" class="px-4 h-full border-b-4 border-white font-medium text-white transition-all">
                        企業管理
                    </button>
                    <button id="tab-btn-job" onclick="switchTab('job')" class="px-4 h-full border-b-4 border-transparent text-indigo-200 hover:text-white hover:border-indigo-400 font-medium transition-all">
                        就職活動管理
                    </button>
                </nav>
            </div>
            <div class="text-sm text-indigo-200">
                ユーザー: 管理者スタッフ | <button class="underline hover:text-white">ログアウト</button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">

        <section id="tab-content-company" class="block">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">企業情報一覧</h2>
                    <p class="text-sm text-slate-500 mt-1">システムに登録されている求人・インターンシップ受入企業のマスタです。</p>
                </div>
                <div class="flex space-x-2">
                    <button onclick="openModal('company-search-input')" class="bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 font-medium px-4 py-2 rounded shadow-sm transition flex items-center text-sm">
                        🔍 詳細検索
                    </button>
                    <button onclick="openCreateCompany()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded shadow transition flex items-center text-sm">
                        ＋ 企業を新規登録
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow overflow-hidden border border-slate-200">
                <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                    <thead class="bg-slate-50 text-slate-600 font-semibold">
                        <tr>
                            <th class="px-6 py-3.5">会社名 / 正式名称</th>
                            <th class="px-6 py-3.5">業種 / 分類</th>
                            <th class="px-6 py-3.5">勤務地 / 本社所在地</th>
                            <th class="px-6 py-3.5">連絡先 / 担当者</th>
                            <th class="px-6 py-3.5 text-center">アクション</th>
                        </tr>
                    </thead>
                    <tbody id="company-table-body" class="divide-y divide-slate-100">
                        </tbody>
                </table>
            </div>
        </section>


        <section id="tab-content-job" class="hidden">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">就職指導・選考状況状況一覧</h2>
                    <p class="text-sm text-slate-500 mt-1">学生個々の応募企業に対する志望順位、および選考ステップの日程管理を行います。</p>
                </div>
                <div>
                    <button onclick="openCreateJob()" class="bg-teal-600 hover:bg-teal-700 text-white font-medium px-4 py-2 rounded shadow transition flex items-center text-sm">
                        ＋ 選考状況を追加
                    </button>
                </div>
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded-lg p-3.5 mb-4 text-xs text-amber-800 flex items-center space-x-4">
                <span class="font-bold">💡 画面仕様・アラート条件:</span>
                <div class="flex items-center"><span class="w-3 h-3 bg-rose-100 border border-rose-300 rounded inline-block mr-1"></span> 選考結果が「×(不合格)」</div>
                <div class="flex items-center"><span class="w-3 h-3 bg-emerald-100 border border-emerald-300 rounded inline-block mr-1"></span> 選考結果が「〇(通過/内定)」</div>
                <div class="flex items-center"><span class="w-3 h-3 bg-amber-100 border border-amber-300 rounded inline-block mr-1"></span> 備考に期限や注意書きを含む要確認レコード</div>
            </div>

            <div class="bg-white rounded-xl shadow overflow-hidden border border-slate-200 overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-600 font-semibold">
                        <tr>
                            <th class="px-4 py-3.5">学生氏名 (性別)</th>
                            <th class="px-4 py-3.5">志望先企業</th>
                            <th class="px-4 py-3.5 text-center">順位</th>
                            <th class="px-4 py-3.5">区分 / 地域</th>
                            <th class="px-4 py-3.5">説明会</th>
                            <th class="px-4 py-3.5">1次選考</th>
                            <th class="px-4 py-3.5">2次選考</th>
                            <th class="px-4 py-3.5 text-center">結果</th>
                            <th class="px-4 py-3.5">結果確定日</th>
                            <th class="px-4 py-3.5">指導備考・期限</th>
                            <th class="px-4 py-3.5 text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody id="job-table-body" class="divide-y divide-slate-100">
                        </tbody>
                </table>
            </div>
        </section>

    </main>

    <div id="modal-container" class="fixed inset-0 modal-backdrop z-50 hidden flex items-center justify-center p-4">
        
        <div id="modal-company-form" class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center sticky top-0 bg-white z-10">
                <h3 id="company-form-title" class="text-lg font-bold text-slate-800">企業情報の登録</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">＆times;</button>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-center justify-center space-x-2 text-xs font-bold text-center pb-2 border-b border-slate-100">
                    <span class="px-3 py-1 bg-indigo-600 text-white rounded-full">1. 入力</span>
                    <span class="text-slate-400">➔</span>
                    <span class="px-3 py-1 bg-slate-200 text-slate-500 rounded-full">2. 確認</span>
                    <span class="text-slate-400">➔</span>
                    <span class="px-3 py-1 bg-slate-200 text-slate-500 rounded-full">3. 完了</span>
                </div>

                <form id="company-form" onsubmit="event.preventDefault(); validateAndConfirmCompany();" class="grid grid-cols-2 gap-4 text-sm">
                    <input type="hidden" id="comp-id">
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">会社名 <span class="text-red-500">*必須</span></label>
                        <input type="text" id="comp-name" class="w-full border border-slate-300 rounded px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="例: 株式会社サンプルシステム">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">会社名（カナ）</label>
                        <input type="text" id="comp-name-kana" class="w-full border border-slate-300 rounded px-3 py-2 focus:ring-2 focus:ring-indigo-500" placeholder="例: カブシキガイシャサンプルシステム">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">正式名称</label>
                        <input type="text" id="comp-official" class="w-full border border-slate-300 rounded px-3 py-2 focus:ring-2 focus:ring-indigo-500" placeholder="例: 株式会社サンプルシステム新潟本社">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">正式名称（カナ）</label>
                        <input type="text" id="comp-official-kana" class="w-full border border-slate-300 rounded px-3 py-2 focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">業種 <span class="text-red-500">*必須</span></label>
                        <select id="comp-industry" class="w-full border border-slate-300 rounded px-3 py-2 bg-white focus:ring-2 focus:ring-indigo-500">
                            <option value="">-- 選択してください --</option>
                            <option value="IT・通信">IT・通信</option>
                            <option value="メーカー">メーカー</option>
                            <option value="商社">商社</option>
                            <option value="金融・保険">金融・保険</option>
                            <option value="サービス">サービス</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">分類</label>
                        <select id="comp-category" class="w-full border border-slate-300 rounded px-3 py-2 bg-white focus:ring-2 focus:ring-indigo-500">
                            <option value="">-- 選択してください --</option>
                            <option value="システム開発">システム開発</option>
                            <option value="インフラ構築">インフラ構築</option>
                            <option value="Webデザイン">Webデザイン</option>
                            <option value="総合職">総合職</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">勤務地</label>
                        <input type="text" id="comp-location" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: 新潟市中央区、東京都内">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">本社所在地</label>
                        <input type="text" id="comp-address" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: 新潟県新潟市中央区万代...">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">電話番号</label>
                        <input type="text" id="comp-phone" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: 025-123-4567">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">採用担当者</label>
                        <input type="text" id="comp-recruiter" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: 人事部 山田太郎">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">メールアドレス</label>
                        <input type="email" id="comp-email" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: recruit@example.com">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">URL</label>
                        <input type="url" id="comp-url" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: https://example.com">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">備考</label>
                        <textarea id="comp-remarks" rows="3" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="自由記入欄"></textarea>
                    </div>

                    <div class="col-span-2 flex justify-end space-x-2 pt-4 border-t border-slate-100">
                        <button type="button" onclick="closeModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded font-medium">キャンセル</button>
                        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded font-medium shadow">次へ確認画面へ ➔</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="modal-company-confirm" class="bg-white rounded-xl shadow-2xl max-w-xl w-full hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-800">登録内容の確認</div>
            <div class="p-6 space-y-4 text-sm">
                <div class="flex items-center justify-center space-x-2 text-xs font-bold text-center pb-2 border-b border-slate-100">
                    <span class="px-3 py-1 bg-slate-200 text-slate-500 rounded-full">1. 入力</span>
                    <span class="text-slate-400">➔</span>
                    <span class="px-3 py-1 bg-indigo-600 text-white rounded-full">2. 確認</span>
                    <span class="text-slate-400">➔</span>
                    <span class="px-3 py-1 bg-slate-200 text-slate-500 rounded-full">3. 完了</span>
                </div>
                <p class="text-slate-600">以下の内容で登録・更新を実行します。よろしいですか？</p>
                <div id="company-confirm-view" class="bg-slate-50 p-4 rounded border border-slate-200 space-y-2 max-h-[50vh] overflow-y-auto">
                    </div>
                <div class="flex justify-between pt-2">
                    <button onclick="backToCompanyForm()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded font-medium">⬅ 修正する</button>
                    <button onclick="submitCompanyData()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded font-medium shadow">確定して登録する 確定</button>
                </div>
            </div>
        </div>


        <div id="modal-job-form" class="bg-white rounded-xl shadow-2xl max-w-xl w-full max-h-[90vh] overflow-y-auto hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center sticky top-0 bg-white z-10">
                <h3 id="job-form-title" class="text-lg font-bold text-slate-800">就職選考状況の登録</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">＆times;</button>
            </div>
            <div class="p-6 space-y-4">
                <form id="job-form" onsubmit="event.preventDefault(); validateAndConfirmJob();" class="grid grid-cols-2 gap-4 text-sm">
                    <input type="hidden" id="job-id">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">学生氏名 <span class="text-red-500">*必須</span></label>
                        <input type="text" id="job-student-name" class="w-full border border-slate-300 rounded px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:outline-none" placeholder="例: 新潟 太郎">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">性別</label>
                        <div class="flex space-x-4 mt-2">
                            <label class="inline-flex items-center"><input type="radio" name="job-gender" value="男" checked class="text-teal-600"> <span class="ml-1">男</span></label>
                            <label class="inline-flex items-center"><input type="radio" name="job-gender" value="女" class="text-teal-600"> <span class="ml-1">女</span></label>
                        </div>
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">対象企業（マスタ連携） <span class="text-red-500">*必須</span></label>
                        <select id="job-company-id" class="w-full border border-slate-300 rounded px-3 py-2 bg-white focus:ring-2 focus:ring-teal-500">
                            </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">志望順位</label>
                        <select id="job-preference" class="w-full border border-slate-300 rounded px-3 py-2 bg-white">
                            <option value="1">第1志望</option>
                            <option value="2">第2志望</option>
                            <option value="3">第3志望</option>
                            <option value="4">その他</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">区分 / 地域</label>
                        <div class="flex space-x-1">
                            <select id="job-class" class="w-1/2 border border-slate-300 rounded px-2 py-2 bg-white">
                                <option value="県内">県内</option>
                                <option value="県外">県外</option>
                            </select>
                            <input type="text" id="job-region" class="w-1/2 border border-slate-300 rounded px-2 py-2" placeholder="例: 新潟、東京">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">会社説明会日程</label>
                        <input type="date" id="job-date-briefing" class="w-full border border-slate-300 rounded px-3 py-2">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">1次選考日程</label>
                        <input type="date" id="job-date-1st" class="w-full border border-slate-300 rounded px-3 py-2">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">2次選考日程</label>
                        <input type="date" id="job-date-2nd" class="w-full border border-slate-300 rounded px-3 py-2">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">選考結果</label>
                        <select id="job-result" class="w-full border border-slate-300 rounded px-3 py-2 bg-white">
                            <option value="選考中">選考中</option>
                            <option value="〇">〇 (通過・内定)</option>
                            <option value="×">× (不合格)</option>
                            <option value="辞退">辞退</option>
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">結果確定日 / 返答締め切り日</label>
                        <input type="date" id="job-date-result" class="w-full border border-slate-300 rounded px-3 py-2">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-600 mb-1">就職指導記録・注意点（備考）</label>
                        <textarea id="job-notes" rows="3" class="w-full border border-slate-300 rounded px-3 py-2" placeholder="例: 〇/〇返答締め切り。辞退の連絡は自分で行うよう指導。"></textarea>
                    </div>

                    <div class="col-span-2 flex justify-end space-x-2 pt-4 border-t border-slate-100">
                        <button type="button" onclick="closeModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded font-medium">キャンセル</button>
                        <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-5 py-2 rounded font-medium shadow">確定して登録する</button>
                    </div>
                </form>
            </div>
        </div>


        <div id="modal-success-complete" class="bg-white rounded-xl shadow-2xl max-w-sm w-full p-6 text-center hidden">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl mx-auto mb-4 font-bold">✓</div>
            <h3 class="text-lg font-bold text-slate-800 mb-1">処理が完了しました</h3>
            <p id="success-message" class="text-sm text-slate-500 mb-6">データは正常に保存されました。</p>
            <button onclick="closeModal()" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-medium py-2 rounded transition text-sm">閉じて一覧を更新</button>
        </div>


        <div id="modal-error-dialog" class="bg-white rounded-xl shadow-2xl max-w-sm w-full p-6 text-center hidden border-t-4 border-red-500">
            <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center text-xl mx-auto mb-3 font-bold">⚠️</div>
            <h3 id="error-title" class="text-base font-bold text-slate-800 mb-2">入力エラー</h3>
            <p id="error-desc" class="text-sm text-slate-600 mb-6 leading-relaxed">必須項目が入力されていません。</p>
            <button onclick="closeErrorModal()" class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-2 rounded transition text-sm">確認</button>
        </div>


        <div id="modal-company-search-input" class="bg-white rounded-xl shadow-2xl max-w-md w-full hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-800 flex justify-between items-center">
                <span>🔍 企業詳細検索</span>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">＆times;</button>
            </div>
            <div class="p-6 space-y-4 text-sm">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">会社名キーワード</label>
                    <input type="text" id="search-comp-name" class="w-full border border-slate-300 rounded px-3 py-2">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">業種から絞り込み</label>
                    <select id="search-comp-industry" class="w-full border border-slate-300 rounded px-3 py-2 bg-white">
                        <option value="">すべて</option>
                        <option value="IT・通信">IT・通信</option>
                        <option value="メーカー">メーカー</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button onclick="closeModal()" class="bg-slate-100 text-slate-600 px-4 py-2 rounded">閉じる</button>
                    <button onclick="executeCompanySearch()" class="bg-indigo-600 text-white px-5 py-2 rounded font-medium shadow">検索実行</button>
                </div>
            </div>
        </div>


        <div id="modal-company-search-results" class="bg-white rounded-xl shadow-2xl max-w-lg w-full hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 font-bold text-slate-800 flex justify-between items-center">
                <span>📊 検索結果ポップアップ</span>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">＆times;</button>
            </div>
            <div class="p-4 max-h-[50vh] overflow-y-auto">
                <table class="min-w-full text-xs text-left divide-y divide-slate-200">
                    <thead class="bg-slate-100 font-bold">
                        <tr>
                            <th class="p-2">会社名</th>
                            <th class="p-2">業種</th>
                            <th class="p-2">勤務地</th>
                        </tr>
                    </thead>
                    <tbody id="search-results-tbody" class="divide-y divide-slate-100">
                        </tbody>
                </table>
            </div>
            <div class="p-4 border-t border-slate-100 flex justify-end">
                <button onclick="closeModal()" class="bg-slate-800 text-white px-4 py-1.5 rounded text-xs">一覧を閉じる</button>
            </div>
        </div>

    </div>

    <script>
        // 1. マスタ・トランザクション初期データ設定
        let companies = [
            { id: 1, name: "アイエックスときわテクノロジー", nameKana: "アイエックストキワテクノロジー", officialName: "株式会社アイエックスときわテクノロジー", officialNameKana: "", industry: "IT・通信", category: "システム開発", location: "新潟市中央区", headOfficeAddress: "新潟県新潟市中央区万代1丁目", phoneNumber: "025-222-1111", recruiterName: "佐藤", email: "sato@ix-tokiwa.co.jp", url: "https://example.com", remarks: "実績多数あり" },
            { id: 2, name: "エヌ・エス・エス", nameKana: "エヌエスエス", officialName: "株式会社エヌ・エス・エス", officialNameKana: "", industry: "IT・通信", category: "インフラ構築", location: "長岡市", headOfficeAddress: "新潟県長岡市大手通", phoneNumber: "0258-33-4444", recruiterName: "高橋", email: "takahashi@nss.co.jp", url: "https://example.com", remarks: "OBOG在籍" },
            { id: 3, name: "北陸システムエンジニアリング", nameKana: "ホクリクシステムエンジニアリング", officialName: "北陸システムエンジニアリング株式会社", officialNameKana: "", industry: "IT・通信", category: "システム開発", location: "新潟・富山", headOfficeAddress: "富山県富山市", phoneNumber: "076-444-5555", recruiterName: "田中", email: "tanaka@hokuriku-se.co.jp", url: "", remarks: "" }
        ];

        let jobApplications = [
            { id: 101, studentName: "三条 拓也", gender: "男", companyId: 1, preferenceOrder: 1, classification: "県内", prefecture: "新潟県", region: "新潟", briefingDate: "2026-04-10", firstSelectionDate: "2026-04-20", secondSelectionDate: "2026-05-10", selectionResult: "〇", resultDate: "2026-05-12", notes: "内定承諾済み。承諾書提出を指導。" },
            { id: 102, studentName: "長岡 舞子", gender: "女", companyId: 2, preferenceOrder: 2, classification: "県内", prefecture: "新潟県", region: "長岡", briefingDate: "2026-04-15", firstSelectionDate: "2026-05-01", secondSelectionDate: "", selectionResult: "×", resultDate: "2026-05-08", notes: "不合格のため他社切り替えの指導実施。" },
            { id: 103, studentName: "新潟 健太", gender: "男", companyId: 1, preferenceOrder: 1, classification: "県内", prefecture: "新潟県", region: "新潟", briefingDate: "2026-05-01", firstSelectionDate: "2026-05-15", secondSelectionDate: "2026-05-20", selectionResult: "選考中", resultDate: "2026-05-21", notes: "5/21返答締め切り。辞退の連絡は自分で行うこと。" }
        ];

        // 2. タブ切り替え制御
        function switchTab(tab) {
            const compBtn = document.getElementById('tab-btn-company');
            const jobBtn = document.getElementById('tab-btn-job');
            const compContent = document.getElementById('tab-content-company');
            const jobContent = document.getElementById('tab-content-job');

            if (tab === 'company') {
                compBtn.className = "px-4 h-full border-b-4 border-white font-medium text-white transition-all";
                jobBtn.className = "px-4 h-full border-b-4 border-transparent text-indigo-200 hover:text-white hover:border-indigo-400 font-medium transition-all";
                compContent.classList.replace('hidden', 'block');
                jobContent.classList.replace('block', 'hidden');
            } else {
                jobBtn.className = "px-4 h-full border-b-4 border-white font-medium text-white transition-all";
                compBtn.className = "px-4 h-full border-b-4 border-transparent text-indigo-200 hover:text-white hover:border-indigo-400 font-medium transition-all";
                jobContent.classList.replace('hidden', 'block');
                compContent.classList.replace('block', 'hidden');
            }
            renderAllTables();
        }

        // 3. モーダル基本開閉
        function openModal(id) {
            document.getElementById('modal-container').classList.remove('hidden');
            // 全モーダルパーツを一旦非表示
            ['modal-company-form', 'modal-company-confirm', 'modal-job-form', 'modal-success-complete', 'modal-error-dialog', 'modal-company-search-input', 'modal-company-search-results'].forEach(mId => {
                document.getElementById(mId).classList.add('hidden');
            });
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal-container').classList.add('hidden');
            renderAllTables();
        }

        function triggerError(title, desc) {
            document.getElementById('error-title').innerText = title;
            document.getElementById('error-desc').innerText = desc;
            document.getElementById('modal-error-dialog').classList.remove('hidden');
        }
        function closeErrorModal() {
            document.getElementById('modal-error-dialog').classList.add('hidden');
        }

        // 4. データ一覧描画エンジン
        function renderAllTables() {
            // --- 企業管理テーブルの生成 ---
            const compTbody = document.getElementById('company-table-body');
            compTbody.innerHTML = '';
            companies.forEach(c => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="px-6 py-4">
                        <div class="font-bold text-slate-900">${c.name}</div>
                        <div class="text-xs text-slate-400">${c.officialName || '-'}</div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="inline-block bg-indigo-50 text-indigo-700 text-xs px-2 py-0.5 rounded font-medium">${c.industry}</span>
                        <div class="text-xs text-slate-500 mt-0.5">${c.category || '-'}</div>
                    </td>
                    <td class="px-6 py-4 text-xs">
                        <div>${c.location || '-'}</div>
                        <div class="text-slate-400">${c.headOfficeAddress || '-'}</div>
                    </td>
                    <td class="px-6 py-4 text-xs">
                        <div>📞 ${c.phoneNumber || '-'}</div>
                        <div class="text-slate-500">👤 ${c.recruiterName || '-'}</div>
                    </td>
                    <td class="px-6 py-4 text-center space-x-2 whitespace-nowrap">
                        <button onclick="openEditCompany(${c.id})" class="text-indigo-600 hover:text-indigo-900 font-semibold text-xs border border-indigo-200 px-2 py-1 rounded bg-white shadow-sm">変更</button>
                        <button onclick="executeDeleteCompany(${c.id})" class="text-red-600 hover:text-red-900 font-semibold text-xs border border-red-100 px-2 py-1 rounded bg-white shadow-sm">削除</button>
                    </td>
                `;
                compTbody.appendChild(tr);
            });

            // --- 就職活動管理テーブルの生成 ---
            const jobTbody = document.getElementById('job-table-body');
            jobTbody.innerHTML = '';
            jobApplications.forEach(j => {
                const compObj = companies.find(c => c.id == j.companyId);
                const compName = compObj ? compObj.name : '不明な企業マスタ';
                
                // アラートカラーの動的判定（画像仕様のシミュレート）
                let rowBgClass = "hover:bg-slate-50";
                if (j.selectionResult === '×') rowBgClass = "bg-rose-50/70 hover:bg-rose-100/60";
                if (j.selectionResult === '〇') rowBgClass = "bg-emerald-50/70 hover:bg-emerald-100/60";
                if (j.notes.includes('締め切り') || j.notes.includes('注意')) rowBgClass = "bg-amber-50/80 hover:bg-amber-100/70";

                const tr = document.createElement('tr');
                tr.className = `${rowBgClass} transition text-xs`;
                tr.innerHTML = `
                    <td class="px-4 py-3.5">
                        <div class="font-bold text-slate-900">${j.studentName}</div>
                        <div class="text-slate-400">${j.gender}</div>
                    </td>
                    <td class="px-4 py-3.5 font-bold text-slate-800">${compName}</td>
                    <td class="px-4 py-3.5 text-center font-bold text-indigo-700">第${j.preferenceOrder}</td>
                    <td class="px-4 py-3.5">
                        <div>${j.classification}</div>
                        <div class="text-slate-400">${j.region}</div>
                    </td>
                    <td class="px-4 py-3.5 text-slate-600">${j.briefingDate || '-'}</td>
                    <td class="px-4 py-3.5 text-slate-600">${j.firstSelectionDate || '-'}</td>
                    <td class="px-4 py-3.5 text-slate-600">${j.secondSelectionDate || '-'}</td>
                    <td class="px-4 py-3.5 text-center">
                        <span class="px-2 py-0.5 rounded-full font-bold ${j.selectionResult === '〇' ? 'bg-emerald-200 text-emerald-800' : j.selectionResult === '×' ? 'bg-rose-200 text-rose-800' : 'bg-slate-200 text-slate-700'}">${j.selectionResult}</span>
                    </td>
                    <td class="px-4 py-3.5 text-slate-600">${j.resultDate || '-'}</td>
                    <td class="px-4 py-3.5 max-w-xs whitespace-normal text-amber-900 font-medium">${j.notes}</td>
                    <td class="px-4 py-3.5 text-center space-x-1">
                        <button onclick="openEditJob(${j.id})" class="text-teal-700 hover:underline font-bold">変更</button>
                        <button onclick="executeDeleteJob(${j.id})" class="text-red-600 hover:underline font-bold ml-2">削除</button>
                    </td>
                `;
                jobTbody.appendChild(tr);
            });

            // 就職管理側セレクトボックスの企業リスト動的補完
            const jobCompSelect = document.getElementById('job-company-id');
            if (jobCompSelect) {
                jobCompSelect.innerHTML = '<option value="">-- マスタから企業を選択 --</option>';
                companies.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.innerText = `${c.name} (${c.industry})`;
                    jobCompSelect.appendChild(opt);
                });
            }
        }

        // 5. 企業管理：登録・変更フロー詳細ロジック
        function openCreateCompany() {
            document.getElementById('company-form').reset();
            document.getElementById('comp-id').value = '';
            document.getElementById('company-form-title').innerText = "企業情報の新規登録";
            openModal('modal-company-form');
        }

        function openEditCompany(id) {
            const c = companies.find(comp => comp.id === id);
            if (!c) return;
            document.getElementById('comp-id').value = c.id;
            document.getElementById('comp-name').value = c.name;
            document.getElementById('comp-name-kana').value = c.nameKana;
            document.getElementById('comp-official').value = c.officialName;
            document.getElementById('comp-official-kana').value = c.officialNameKana;
            document.getElementById('comp-industry').value = c.industry;
            document.getElementById('comp-category').value = c.category;
            document.getElementById('comp-location').value = c.location;
            document.getElementById('comp-address').value = c.headOfficeAddress;
            document.getElementById('comp-phone').value = c.phoneNumber;
            document.getElementById('comp-recruiter').value = c.recruiterName;
            document.getElementById('comp-email').value = c.email;
            document.getElementById('comp-url').value = c.url;
            document.getElementById('comp-remarks').value = c.remarks;
            
            document.getElementById('company-form-title').innerText = "企業情報の編集・修正";
            openModal('modal-company-form');
        }

        // バリデーション ＆ ステップ遷移（確認画面へ）
        function validateAndConfirmCompany() {
            const name = document.getElementById('comp-name').value.trim();
            const industry = document.getElementById('comp-industry').value;
            const id = document.getElementById('comp-id').value;

            // ① 必須項目漏れエラーハンドリング
            if (!name || !industry) {
                triggerError("必須項目漏れ", "「会社名」および「業種」は必須入力項目です。確認して再入力してください。");
                return;
            }

            // ② 重複登録エラーハンドリング（新規時のみ、同名チェック）
            const isDuplicate = companies.some(c => c.name === name && c.id != id);
            if (isDuplicate) {
                triggerError("重複登録エラー", `「${name}」は既にシステムに登録されています。別の会社名を指定するか、既存のデータを編集してください。`);
                return;
            }

            // 確認ダイアログのHTMLビュー組み立て
            const view = document.getElementById('company-confirm-view');
            view.innerHTML = `
                <div><span class="text-slate-400 inline-block w-28">会社名:</span> <strong>${name}</strong></div>
                <div><span class="text-slate-400 inline-block w-28">業種:</span> <span>${industry}</span></div>
                <div><span class="text-slate-400 inline-block w-28">分類:</span> <span>${document.getElementById('comp-category').value || '-'}</span></div>
                <div><span class="text-slate-400 inline-block w-28">勤務地:</span> <span>${document.getElementById('comp-location').value || '-'}</span></div>
                <div><span class="text-slate-400 inline-block w-28">電話番号:</span> <span>${document.getElementById('comp-phone').value || '-'}</span></div>
                <div><span class="text-slate-400 inline-block w-28">担当者:</span> <span>${document.getElementById('comp-recruiter').value || '-'}</span></div>
                <div class="pt-1 text-xs text-indigo-600 border-t border-slate-200 mt-2">※確定ボタンを押すことで、データベースへコミットされます。</div>
            `;

            // モーダルの表示切替（入力 ➔ 確認）
            document.getElementById('modal-company-form').classList.add('hidden');
            document.getElementById('modal-company-confirm').classList.remove('hidden');
        }

        function backToCompanyForm() {
            document.getElementById('modal-company-confirm').classList.add('hidden');
            document.getElementById('modal-company-form').classList.remove('hidden');
        }

        // コミット確定・データ反映
        function submitCompanyData() {
            const id = document.getElementById('comp-id').value;
            const companyPayload = {
                id: id ? parseInt(id) : Date.now(),
                name: document.getElementById('comp-name').value,
                nameKana: document.getElementById('comp-name-kana').value,
                officialName: document.getElementById('comp-official').value,
                officialNameKana: document.getElementById('comp-official-kana').value,
                industry: document.getElementById('comp-industry').value,
                category: document.getElementById('comp-category').value,
                location: document.getElementById('comp-location').value,
                headOfficeAddress: document.getElementById('comp-address').value,
                phoneNumber: document.getElementById('comp-phone').value,
                recruiterName: document.getElementById('comp-recruiter').value,
                email: document.getElementById('comp-email').value,
                url: document.getElementById('comp-url').value,
                remarks: document.getElementById('comp-remarks').value
            };

            if (id) {
                // 変更アップデート
                const idx = companies.findIndex(c => c.id === parseInt(id));
                companies[idx] = companyPayload;
            } else {
                // 新規追加
                companies.push(companyPayload);
            }

            // 完了ダイアログへ
            document.getElementById('modal-company-confirm').classList.add('hidden');
            document.getElementById('success-message').innerText = "企業情報のデータベース保存・更新が正常に完了いたしました。";
            document.getElementById('modal-success-complete').classList.remove('hidden');
        }

        // ③ 削除不可ガードレールロジック（整合性制約）
        function executeDeleteCompany(id) {
            const comp = companies.find(c => c.id === id);
            
            // 就職管理側で学生に紐付いているかをチェック
            const hasRelation = jobApplications.some(j => j.companyId === id);
            if (hasRelation) {
                triggerError("削除不可エラー", `選択された企業「${comp.name}」は、現在就職活動管理側で学生の選考状況データと紐付いているため削除できません。関連する学生レコードを先に変更・削除してください。`);
                return;
            }

            if (confirm(`企業「${comp.name}」を削除します。よろしいですか？`)) {
                companies = companies.filter(c => c.id !== id);
                renderAllTables();
                alert("削除が完了しました。");
            }
        }


        // 6. 就職活動管理：登録・変更フロー詳細ロジック
        function openCreateJob() {
            document.getElementById('job-form').reset();
            document.getElementById('job-id').value = '';
            document.getElementById('job-form-title').innerText = "選考・就職指導状況の新規追加";
            openModal('modal-job-form');
        }

        function openEditJob(id) {
            const j = jobApplications.find(job => job.id === id);
            if (!j) return;
            document.getElementById('job-id').value = j.id;
            document.getElementById('job-student-name').value = j.studentName;
            document.getElementById('job-company-id').value = j.companyId;
            document.getElementById('job-preference').value = j.preferenceOrder;
            document.getElementById('job-class').value = j.classification;
            document.getElementById('job-region').value = j.region;
            document.getElementById('job-date-briefing').value = j.briefingDate;
            document.getElementById('job-date-1st').value = j.firstSelectionDate;
            document.getElementById('job-date-2nd').value = j.secondSelectionDate;
            document.getElementById('job-result').value = j.selectionResult;
            document.getElementById('job-date-result').value = j.resultDate;
            document.getElementById('job-notes').value = j.notes;

            // 性別ラジオ設定
            const genders = document.getElementsByName('job-gender');
            genders.forEach(g => { if(g.value === j.gender) g.checked = true; });

            document.getElementById('job-form-title').innerText = "選考・就職指導状況の変更";
            openModal('modal-job-form');
        }

        function validateAndConfirmJob() {
            const studentName = document.getElementById('job-student-name').value.trim();
            const companyId = document.getElementById('job-company-id').value;

            if (!studentName || !companyId) {
                triggerError("必須項目漏れ", "「学生氏名」および「対象企業」は必須項目です。");
                return;
            }

            const id = document.getElementById('job-id').value;
            const genders = document.getElementsByName('job-gender');
            let genderVal = "男";
            genders.forEach(g => { if(g.checked) genderVal = g.value; });

            const jobPayload = {
                id: id ? parseInt(id) : Date.now(),
                studentName: studentName,
                gender: genderVal,
                companyId: parseInt(companyId),
                preferenceOrder: parseInt(document.getElementById('job-preference').value),
                classification: document.getElementById('job-class').value,
                region: document.getElementById('job-region').value,
                briefingDate: document.getElementById('job-date-briefing').value,
                firstSelectionDate: document.getElementById('job-date-1st').value,
                secondSelectionDate: document.getElementById('job-date-2nd').value,
                selectionResult: document.getElementById('job-result').value,
                resultDate: document.getElementById('job-date-result').value,
                notes: document.getElementById('job-notes').value
            };

            if (id) {
                const idx = jobApplications.findIndex(j => j.id === parseInt(id));
                jobApplications[idx] = jobPayload;
            } else {
                jobApplications.push(jobPayload);
            }

            document.getElementById('modal-job-form').classList.add('hidden');
            document.getElementById('success-message').innerText = "学生の就職選考状況を反映・保存しました。";
            document.getElementById('modal-success-complete').classList.remove('hidden');
        }

        function executeDeleteJob(id) {
            if (confirm("この学生の選考レコードを削除してよろしいですか？")) {
                jobApplications = jobApplications.filter(j => j.id !== id);
                renderAllTables();
            }
        }

        // 7. 詳細検索シミュレーター
        function executeCompanySearch() {
            const keyword = document.getElementById('search-comp-name').value.toLowerCase();
            const industry = document.getElementById('search-comp-industry').value;

            const filtered = companies.filter(c => {
                const matchKey = c.name.toLowerCase().includes(keyword) || c.officialName.toLowerCase().includes(keyword);
                const matchInd = industry === "" || c.industry === industry;
                return matchKey && matchInd;
            });

            // 結果ダイアログの生成
            const resTbody = document.getElementById('search-results-tbody');
            resTbody.innerHTML = '';
            if(filtered.length === 0) {
                resTbody.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-slate-400">該当する企業は見つかりませんでした。</td></tr>';
            } else {
                filtered.forEach(c => {
                    resTbody.innerHTML += `
                        <tr class="hover:bg-slate-50">
                            <td class="p-2 font-bold text-slate-800">${c.name}</td>
                            <td class="p-2">${c.industry}</td>
                            <td class="p-2">${c.location}</td>
                        </tr>
                    `;
                });
            }
            openModal('modal-company-search-results');
        }

        // 初回起動時のレンダリング
        window.onload = function() {
            renderAllTables();
        };
    </script>
</body>
</html>






























